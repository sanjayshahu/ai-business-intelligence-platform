{
  "name": "react-prep",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "react-prep",
        "command": "vite build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "react-prep",
        "command": "vite"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "react-prep",
        "command": "vite preview"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "react-prep",
        "command": "vitest"
      }
    }
  }
}