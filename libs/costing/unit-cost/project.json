{
  "name": "@org/costing-unit-cost",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/costing/unit-cost/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:costing"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/costing/unit-cost"],
      "options": {
        "command": "tsc -p libs/costing/unit-cost/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/costing/unit-cost/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
     "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "libs/costing/unit-cost/vite.config.ts"
      }
    }
  }
}